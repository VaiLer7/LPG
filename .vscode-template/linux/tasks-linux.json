{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Criar pasta executaveis",
            "type": "shell",
            "command": "mkdir",
            "args": [
                "-p",
                "\"${fileDirname}/executaveis\""
            ]
        },
        {
            "label": "Compilar C",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O0",
                "\"${file}\"",
                "-o",
                "\"${fileDirname}/executaveis/${fileBasenameNoExtension}\""
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Completo",
            "dependsOn": [
                "Criar pasta executaveis",
                "Compilar C"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}